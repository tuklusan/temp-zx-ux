#define HDR "t6_twice.h"
#include HDR
int main(void) { return 0; }
//== pp_include_not_found P0777
#include "no_such_file.h"
int main(void) { return 0; }
//== pp_include_case P0903
#include "T6_twice.h"
int main(void) { return 0; }
//== pp_include_nested P0727 P0741 P0903
#include "t6_nest.h"
int main(void) { return 0; }
//== pp_include_unterminated P0742
#include "t6_twice.h
int main(void) { return 0; }
//== pp_angle_other P0732 P0903
#include <stdio.h>
int main(void) { return 0; }
//== pp_angle_local_name P0732
#include <t6_twice.h>
int main(void) { return 0; }
