//== hd_conflicting_prototype P0734 P0903
int putchar(float c);
#include <c48.h>
int main(void) { return 0; }
//== hd_conflicting_after P0734
#include <c48.h>
int strlen(char *s);
int main(void) { return 0; }
//== hd_object_collides P0734
int puts;
#include <c48.h>
int main(void) { return 0; }
//== hd_macro_hides_function P0734
#define putchar 1
#include <c48.h>
int main(void) { return 0; }
//== hd_no_printf P1043
#include <c48.h>
int main(void) { printf("x"); return 0; }
//== pp_name_16_chars P0085 P0087 P0716
#define ABCDEFGHIJKLMNOP 1
int main(void) { return 0; }
