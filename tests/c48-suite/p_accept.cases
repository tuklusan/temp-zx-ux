{
    return !(A == 3);
}
//== ac_compare_void_pointer_null P0328 P0531 P0532
int main(void)
{
    void *v;
    int x;
    int *p;
    v = &x;
    p = &x;
    return !(v == p && p == v && v != 0);
}
//== ac_pointer_one_past P0535 P0542
int main(void)
{
    int a[3];
    int *p;
    int n;
    n = 0;
    for (p = a; p < a + 3; p++)
        n++;
    return !(n == 3 && p == &a[2] + 1);
}
