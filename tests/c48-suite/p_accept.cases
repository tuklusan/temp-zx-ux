//== ac_float_copy P0552
int main(void)
{
    float a;
    float b;
    unsigned char *x;
    unsigned char *y;
    void *t;
    int i;
    int same;
    a = 0.1;
    b = a;
    t = &a;
    x = t;
    t = &b;
    y = t;
    same = 1;
    for (i = 0; i < 5; i++)
        if (x[i] != y[i])
            same = 0;
    return !same;
}
