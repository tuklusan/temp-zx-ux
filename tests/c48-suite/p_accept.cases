// p_accept.cases - C48 positive corpus: small programs that must compile,
// link and exit with status 0 on both back ends (each case is built on its
// own, so one rejected construct does not hide the others).  Format as in
// n1_lex.cases.  Options: nolf (no LF after the last line), crlf (CRLF line
// ends), may (an optional or conditional requirement: a failure is reported
// as NOTE, not FAIL - P0046 says a host compiler MAY accept CRLF; P0319
// requires NULL "once the <c48.h> declaration set is frozen").
//== ac_final_line_no_lf P0054 P0055 P1066 nolf
int main(void) { return 0; }
//== ac_crlf_input P0046 crlf may
int main(void)
{
    return 0;
}
//== ac_comments_only_lines P0074 P0079 nolf
int main(void) { return 0; } // a final line comment without LF
//== ac_sizeof_object_in_initializer P0412
int other;
int g = sizeof other;
int main(void) { return !(g == 2); }
//== ac_visible_after_declarator P0270
int g = sizeof g;
int main(void)
{
    int l = sizeof l;
    return !(g == 2 && l == 2);
}
//== ac_float_postfix_value P0563 P0564 P0565 P1073
int main(void)
{
    float f;
    float g;
    f = 2.0;
    g = f++;
    return !(g == 2.0 && f == 3.0);
}
//== ac_float_prefix_value P0563 P0564 P0565
int main(void)
{
    float f;
    float g;
    f = 2.0;
    g = --f;
    return !(g == 1.0 && f == 1.0);
}
//== ac_float_param_first P0342 P0596 P0604 P0957 P1061
int g(float a, int b)
{
    return b + (a == 1.0);
}
int main(void)
{
    return !(g(1.0, 6) == 7);
}
//== ac_float_params_two P0342 P0596 P0604 P1078
float add(float a, float b)
{
    a = a + b;
    return a;
}
int main(void)
{
    float x;
    x = 2.0;
    return !(add(x, 3.0) == 5.0 && x == 2.0);
}
//== ac_null_macro P0317 P0318 P0319 may
#include <c48.h>
int main(void)
{
    int *p;
    p = NULL;
    return !(p == 0 && NULL == 0);
}
//== ac_neg_32768_int P0146 P0477
int x = -32768;
int main(void)
{
    return !(x < 0 && x == (int)0x8000u);
}
//== ac_void_pointer_init P0400 P0403
int g;
void *vp = &g;
int main(void)
{
    int *p;
    p = vp;
    return !(p == &g);
}
//== ac_string_sequence_init P0178 P0407 P1028
char *p = "ab" "cd";
char t[] = "ab" "cd";
int main(void)
{
    return !(p[3] == 'd' && sizeof(t) == 5);
}
//== ac_triple_pointer P0240 P0307
int main(void)
{
    char c;
    char *p;
    char **pp;
    char ***ppp;
    p = &c;
    pp = &p;
    ppp = &pp;
    ***ppp = 'z';
    return !(c == 'z');
}
//== ac_long_names_everywhere P0085 P0716
#define ABCDEFGHIJKLMNO 3
int abcdefghijklmno(int abcdefghijkl_m)
{
    return abcdefghijkl_m + ABCDEFGHIJKLMNO;
}
int main(void)
{
    return !(abcdefghijklmno(1) == 4);
}
