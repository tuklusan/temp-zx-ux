}
//== ac_empty_translation_unit_with_main_only P0769 P1066
/* only comments and main */
int main(void) { return 0; }
//== ac_assembler_like_names P0277 P0287
int hl;
int ld;
int sp;
int ix;
int af(void)
{
    return 1;
}
int jp(int a)
{
    return a;
}
int main(void)
{
    hl = 1;
    ld = 2;
    sp = 3;
    ix = 4;
    return !(hl + ld + sp + ix + af() + jp(5) == 16);
}
//== ac_spec_examples P0245 P0299 P0377 P0379 P0646 P0710
#define SIZE 10
#define MASK (1 << 4)
#define HALF .5
#define NAME "zx-ux"
int x;
int x2, y;
unsigned int mask;
char *p;
int values[10];
char bytes[16];
float samples[4];
char *names[8];
int a[3] = { 1, 2, 3 };
int b[4] = { 1, 2, };
int function(void)
{
    return 5;
}
int main(void)
{
    int i;
    x = function();
    i = 0;
    i++;
    ;
    return !(x == 5 && b[3] == 0 && sizeof(samples) == 20 && sizeof(names) == 16 && SIZE == 10 && MASK == 16 && i == 1);
}
//== ac_include_with_c48h P1055 P0727
#include "t6_c48.h"
