int f(void *p)
{
    return p == 0;
}
int main(void)
{
    return !f(0);
}
//== ac_argv_repeated_index P0241 P0868 P1051
int main(int argc, char **argv)
{
    return !(argv[0][0] != 0 && argc >= 1);
}
//== ac_return_conversion P0694 P0549 P0551
int f(void)
{
    return 3.75;
}
float g(void)
{
    return 7;
}
char h(void)
{
    return 513;
}
int main(void)
{
    return !(f() == 3 && g() == 7.0 && h() == 1);
}
//== ac_assign_null_constant_expression P0315 P0555
