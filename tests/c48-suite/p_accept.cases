{
    return !(p[3] == 'd' && sizeof(t) == 5);
}
//== ac_triple_pointer P0240 P0307
int main(void)
{
    char c;
    char *p;
    char **pp;
    char ***ppp;
    p = &c;
    pp = &p;
    ppp = &pp;
    ***ppp = 'z';
    return !(c == 'z');
}
