int main(void) { return 08; }
//== int_bad_octal9 P0143
int main(void) { return 019; }
//== int_hex_no_digit P0143
int main(void) { return 0x; }
//== int_suffix_l P0138 P0139 P0837
int main(void) { return 1L; }
//== int_suffix_l_lower P0138 P0139
int main(void) { return 1l; }
//== int_suffix_ul P0138 P0139 P0837
