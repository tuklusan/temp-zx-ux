//== flt_exp_sign_no_digits P0186
int main(void) { float f; f = 1e+; return 0; }
//== flt_suffix_ff P0186
int main(void) { float f; f = 1.0ff; return 0; }
//== flt_overflow P0207
int main(void) { float f; f = 1e39; return 0; }
//== flt_overflow_2 P0207
int main(void) { float f; f = 1.8e38; return 0; }
//== flt_int_suffix_f P0186
int main(void) { float f; f = 1f; return 0; }
//== flt_unsigned_suffix P0186 P0188
int main(void) { float f; f = 1.5u; return 0; }
//== op_plus_eq P0127 P0129 P0837 P0126
int main(void) { int x; x = 1; x += 2; return 0; }
//== op_minus_eq P0127 P0837 P0126
int main(void) { int x; x = 1; x -= 2; return 0; }
//== op_star_eq P0127 P0126
int main(void) { int x; x = 1; x *= 2; return 0; }
//== op_slash_eq P0127 P0126
int main(void) { int x; x = 1; x /= 2; return 0; }
//== op_percent_eq P0127 P0126
int main(void) { int x; x = 1; x %= 2; return 0; }
//== op_shl_eq P0127 P0126
int main(void) { int x; x = 1; x <<= 2; return 0; }
//== op_shr_eq P0127 P0126
int main(void) { int x; x = 1; x >>= 2; return 0; }
//== op_and_eq P0127 P0126
int main(void) { int x; x = 1; x &= 2; return 0; }
//== op_or_eq P0127 P0126
int main(void) { int x; x = 1; x |= 2; return 0; }
//== op_xor_eq P0127 P0126
int main(void) { int x; x = 1; x ^= 2; return 0; }
//== op_conditional P0127 P0436 P0837 P0126 P1033
int main(void) { int x; x = 1 ? 2 : 3; return 0; }
//== op_question_only P0127 P0837 P0126
int main(void) { int x; x = 1 ? 2; return 0; }
//== op_colon_only P0127 P0126
int main(void) { int x; x = 1 : 2; return 0; }
//== op_arrow P0127 P0837 P0126
int main(void) { int *p; p = 0; return p->x; }
//== op_member P0127 P0128 P0451 P0126 P1033
int main(void) { int x; x = 1; return x.y; }
//== op_ellipsis P0127 P0344 P0837 P0126
int main(void) { return ...; }
//== op_comma_expr P0125 P0437 P0126 P1033
int main(void) { int x; x = (1, 2); return 0; }
//== op_comma_stmt P0125 P0437 P0126
int main(void) { int x; int y; x = 1, y = 2; return 0; }
//== op_comma_for P0125 P0126
int main(void) { int i; int j; for (i = 0, j = 0; i < 2; i++) ; return 0; }
//== op_fused_minus P0120 P0126
int main(void) { int i; int j; i = 1; j = 2; return i--j; }
