// n1_lex.cases - C48 negative corpus: source bytes, comments, identifiers,
// tokens and literals (spec sections 4-17, 87).  Each "//== id P.... "
// line starts one case; run_suite.py compiles every case on its own and
// requires rcc to reject it (status 1, "rcc:" diagnostic on stderr, no
// output file).  <<XX>> stands for the byte with hexadecimal value XX.
// Options after the paragraphs: diag=REGEX must match the diagnostic.
//== lex_cr_byte P0044 P0045
int main(void) { return 0;<<0D>> }
//== lex_nul_byte P0044 P0045
int main(void) { return 0; }<<00>>
//== lex_high_byte P0044 P0045 P0049
int main(void) { return 0; } /* <<E9>> */
//== lex_utf8_string P0049 P0050
int main(void) { char *s; s = "<<C3>><<A9>>"; return 0; }
//== lex_bom P0048
<<EF>><<BB>><<BF>>int main(void) { return 0; }
//== lex_control_byte P0044 P0045
int main(void) { return<<01>>0; }
//== lex_form_feed P0044 P0065
int main(void) { return<<0C>>0; }
//== lex_vertical_tab P0044 P0065
int main(void) { return<<0B>>0; }
//== lex_splice_code P0056 P0057 P0058 P0059 P0060
int main(void) { return 1 \
+ 2; }
//== lex_splice_ident P0056 P0058 P0059 P0060
int ab\
c; int main(void) { return 0; }
//== lex_comment_unterminated P0077
int main(void) { return 0; } /* never closed
//== lex_comment_nested P0076
int main(void) { /* outer /* inner */ still comment */ return 0; }
//== lex_trigraph P0051 P0787
int main(void) { return '??/0'; }
//== lex_digraph P0051 P0787
int main(void) <% return 0; %>
//== lex_ucn P0051 P0787
int main(void) { int \u0041; return 0; }
//== lex_ident_16 P0085 P0087 P0837
int abcdefghijklmnop; int main(void) { return 0; }
//== lex_ident_16_local P0087 P0088
int main(void) { int identifier_longer; return 0; }
//== lex_ident_long_spec P0837
int main(void) { int identifier_longer_than_15_visible_characters; return 0; }
//== lex_ident_dollar P0083 P0132
int main(void) { int a$b; return 0; }
//== lex_stray_at P0132
int main(void) { return @1; }
//== lex_stray_backquote P0132
int main(void) { return `1; }
//== lex_stray_backslash P0132
int main(void) { return \ 1; }
//== lex_hash_midline P0132 P0703
int main(void) { return # 1; }
