//== flt_suffix_L P0189 P0837
int main(void) { float f; f = 1.0L; return 0; }
//== flt_suffix_l P0189
int main(void) { float f; f = 1.0l; return 0; }
//== flt_hex P0189 P0837
int main(void) { float f; f = 0x1.0p0; return 0; }
//== flt_hex_p P0189
int main(void) { float f; f = 0x1p3; return 0; }
